{
  "name": "medialert-network",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "apps/web",
    "apps/mobile",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w apps/web",
    "dev:mobile": "npm run dev -w apps/mobile",
    "db:seed": "npm run seed -w server",
    "build": "npm run build -w packages/shared && npm run build -w apps/web",
    "lint": "npm run lint -w apps/web && npm run lint -w server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
